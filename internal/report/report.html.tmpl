<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Archaeologist report — {{.Host}} (scan #{{.ScanID}})</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 60rem; padding: 0 1rem; line-height: 1.5; }
  h1 { border-bottom: 2px solid #888; padding-bottom: .3rem; }
  h2 { margin-top: 2rem; border-bottom: 1px solid #ccc; padding-bottom: .2rem; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  th, td { border: 1px solid #bbb; padding: .4rem .6rem; text-align: left; }
  th { background: rgba(128,128,128,.15); }
  .meta { color: #666; font-size: .9rem; }
  .severity-warn { color: #b00020; font-weight: 600; }
  .severity-info { color: #3366cc; }
  .blind { background: rgba(180,120,0,.08); border-left: 4px solid #c80; padding: .5rem .8rem; margin: .3rem 0; }
  code { background: rgba(128,128,128,.12); padding: 0 .25rem; border-radius: 3px; }
  ul { padding-left: 1.4rem; }
</style>
</head>
<body>
<h1>Archaeologist report — {{.Host}} (scan #{{.ScanID}})</h1>
<p class="meta">Status: <code>{{.Status}}</code> · Generated: <code>{{.GeneratedAt}}</code></p>

<h2>Dashboard</h2>
<table>
  <tr><th>Metric</th><th>Value</th></tr>
  <tr><td>Entities</td><td>{{entityTotal .Dashboard.EntitiesByKind}}</td></tr>
  <tr><td>Findings</td><td>{{.Dashboard.Findings}}</td></tr>
  <tr><td>Blind spots</td><td>{{.Dashboard.BlindSpots}}</td></tr>
</table>
<h3>Verdicts</h3>
<ul>
{{range $k, $v := .Dashboard.Verdict}}  <li><strong>{{$k}}</strong>: {{$v}}</li>
{{end}}</ul>
<h3>Entities by kind</h3>
<ul>
{{range $k, $v := .Dashboard.EntitiesByKind}}  <li><strong>{{$k}}</strong>: {{$v}}</li>
{{end}}</ul>

<h2>Blind spots</h2>
<p class="meta">Blind spots are evidence: the conclusions below may lack blocked sources.</p>
{{if .BlindSpots}}
<ul>
{{range .BlindSpots}}  <li class="blind">[{{.Channel}}] {{.Reason}}{{if .EntityName}} — {{.EntityKind}} <code>{{.EntityName}}</code>{{else}} — host{{end}}</li>
{{end}}</ul>
{{else}}<p>_No blind spots._</p>{{end}}

<h2>Findings</h2>
{{if .Findings}}
<ul>
{{range .Findings}}  <li><span class="severity-{{.Severity}}">{{.Severity}}</span> <strong>{{.Kind}}</strong> — {{.EntityKind}} <code>{{.EntityName}}</code>: {{detailInline .Detail}}</li>
{{end}}</ul>
{{else}}<p>_No findings._</p>{{end}}

<p class="meta">Generated by Archaeologist — read-only infrastructure report. Secrets are redacted.</p>
</body>
</html>
