# Copy this file to .env (gitignored) and fill in the real VPS IP.
#   cp .env.example .env
#
# Inline environment variables (LAB_SSH=... ./lab/up.sh) always take
# precedence over values in this file.

LAB_SSH=root@203.0.113.10
# LAB_SSH_KEY=~/.ssh/id_ed25519

# LLM explainer (opt-in: only read when you pass --explain).

ARCHAEOLOGIST_LLM_BASE_URL=https://openrouter.ai/api/v1
ARCHAEOLOGIST_LLM_API_KEY=
ARCHAEOLOGIST_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
